{
    "name": "frank6com/fastadmin-addons",
    "description": "fork from fastadminnet/fastadmin-addons",
    "homepage": "https://github.com/frank6com/fastadmin-addons",
    "license": "Apache-2.0",
    "version": "1.4.4",
    "authors": [
        {
            "name": "Frank6",
            "email": "auv@auv.me"
        }
    ],
    "support": {
        "issues": "https://github.com/frank6com/fastadmin-addons/issues"
    },
    "require": {
        "php": ">=7.1.0",
        "nelexa/zip": "^3.3 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "think\\": "src/"
        },
        "files": [
            "src/common.php"
        ]
    },
    "extra": {
        "think-config": {
            "addons": "src/config.php"
        }
    },
    "replace": {
        "fastadminnet/fastadmin-addons": "self.version"
    },
    "conflict": {
        "fastadminnet/fastadmin-addons": "*"
    }
}
